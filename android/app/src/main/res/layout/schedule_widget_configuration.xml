<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/schedule_widget_settings" android:textSize="24sp"
            android:textStyle="bold" android:textColor="@color/schedule_widget_text"
            android:layout_marginBottom="24dp" android:accessibilityHeading="true" />
        <FrameLayout android:id="@+id/schedule_widget_preview"
            android:layout_width="match_parent" android:layout_height="292dp"
            android:padding="16dp" android:background="@color/schedule_widget_preview_background"
            android:importantForAccessibility="noHideDescendants" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="24dp"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textSize="18sp"
                android:labelFor="@id/schedule_widget_transparency_slider"
                android:text="@string/schedule_widget_transparency"
                android:textColor="@color/schedule_widget_text" />
            <TextView android:id="@+id/schedule_widget_transparency_value"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:textSize="18sp"
                android:textColor="@color/schedule_accent" />
        </LinearLayout>
        <SeekBar android:id="@+id/schedule_widget_transparency_slider"
            android:layout_width="match_parent" android:layout_height="48dp" android:max="100" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/schedule_widget_transparency_hint" android:textSize="14sp"
            android:textColor="@color/schedule_widget_secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/schedule_widget_theme"
            android:labelFor="@id/schedule_widget_theme" android:textSize="16sp"
            android:textColor="@color/schedule_widget_text" />
        <Spinner android:id="@+id/schedule_widget_theme"
            android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/schedule_widget_text_size"
            android:labelFor="@id/schedule_widget_text_size" android:textSize="16sp"
            android:textColor="@color/schedule_widget_text" />
        <Spinner android:id="@+id/schedule_widget_text_size"
            android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/schedule_widget_max_lessons"
            android:labelFor="@id/schedule_widget_max_lessons" android:textSize="16sp"
            android:textColor="@color/schedule_widget_text" />
        <Spinner android:id="@+id/schedule_widget_max_lessons"
            android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/schedule_widget_lessons_hint" android:textSize="14sp"
            android:textColor="@color/schedule_widget_secondary" />
        <Switch android:id="@+id/schedule_widget_show_location"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:layout_marginTop="12dp"
            android:text="@string/schedule_widget_show_location" android:textSize="16sp"
            android:textColor="@color/schedule_widget_text" />
        <Switch android:id="@+id/schedule_widget_show_lecturer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:text="@string/schedule_widget_show_lecturer"
            android:textSize="16sp" android:textColor="@color/schedule_widget_text" />
        <Button android:id="@+id/schedule_widget_reset"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/schedule_widget_reset" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="end" android:layout_marginTop="24dp">
            <Button android:id="@+id/schedule_widget_cancel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/schedule_widget_cancel" />
            <Button android:id="@+id/schedule_widget_save"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="@string/schedule_widget_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
